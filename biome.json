{
	"$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"useHookAtTopLevel": "error",
				"noUnusedVariables": "error",
				"noUnusedImports": "error"
			},
			"suspicious": {
				"noConsole": { "level": "warn", "options": { "allow": ["log"] } }
			}
		}
	},
	"formatter": {
		"enabled": true
	}
}
